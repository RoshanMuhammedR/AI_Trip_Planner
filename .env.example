# Firebase project config (Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AICredits API key (https://aicredits.in/dashboard/keys) — used only by /api/generate.
# NO VITE_ prefix on purpose: VITE_* vars are inlined into the client bundle.
AICREDITS_API_KEY=

# Google Places/Maps API key (Google Cloud Console)
# Needs BOTH "Places API (New)" and "Maps JavaScript API" enabled.
VITE_GOOGLE_PLACE_API_KEY=

# Map ID for the trip map (Cloud Console > Google Maps Platform > Map Management
# > Create Map ID, type: JavaScript, rendering: Vector). Required — advanced
# markers render nothing without one.
VITE_GOOGLE_MAPS_MAP_ID=

# Google sign-in is handled by Firebase Auth (Console > Authentication >
# Sign-in method > Google), so no separate OAuth client ID is needed.
