# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
# NOTHING here is prefixed with NEXT_PUBLIC_, which means none of it is
# bundled into client JavaScript. That is deliberate: the previous version of
# this app shipped its Gemini key to every visitor in the browser bundle.
# ---------------------------------------------------------------------------

# --- Site (optional) -------------------------------------------------------
# Canonical origin, used for metadata, Open Graph URLs, robots and sitemap.
# This one IS public by design; it contains no secret. Vercel sets it per
# deployment if you leave it blank locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (required) ---------------------------------------------------
# Neon serverless Postgres. Use the POOLED connection string ("-pooler" host).
# https://console.neon.tech  ->  Project -> Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (required) ---------------------------------------------
# Generate with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (required) ---------------------------------------------------------
# https:// aistudio.google.com/apikey — server-side only, never exposed.
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Destination search (required) -----------------------------------------
# https://console.mapbox.com — Search Box API. Prefer a SECRET token (sk.…) so
# it cannot be replayed from a browser even if it were to escape the server.
MAPBOX_ACCESS_TOKEN=""
